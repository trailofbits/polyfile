{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "complexity": ["error", 8],
    "max-lines-per-function": [
      "error",
      { "max": 50, "skipBlankLines": true, "skipComments": true }
    ],
    "max-params": ["error", 5]
  }
}
